# Copy this file to .env.local and adjust as needed.

# Base URL of the backend API (see backend/.env's PORT — defaults to 4000).
NEXT_PUBLIC_API_URL=http://localhost:4000

# The bare app domain (no protocol, no path) — used to detect a school's
# subdomain (<slug>.<this value>) so the login page can auto-fill/lock the
# school field instead of asking the user to type it. In production this
# is your real domain, e.g. "yourschoolsaas.com". Locally, "localhost:3000"
# works out of the box — modern browsers resolve any "*.localhost" hostname
# to 127.0.0.1 automatically, so visiting
# http://alpha-school.localhost:3000/login needs no /etc/hosts changes.
# Leave unset to disable subdomain detection entirely (manual entry only).
#
# NOTE: this local *.localhost setup fully exercises the subdomain
# detection/auto-fill UI and CORS. It does NOT fully exercise session
# persistence after login — Chrome refuses to share a cookie across
# *.localhost subdomains (treats "localhost" like a public suffix, a
# "supercookie" protection), even though DNS-wise those subdomains resolve
# fine. A real registered domain (e.g. yourschoolsaas.com in production)
# doesn't have this restriction. See backend/.env's COOKIE_DOMAIN comment.
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
