# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Database (Postgres). School SaaS uses shared DB + tenant_id + Row-Level Security.
DATABASE_URL="postgresql://school_saas_app:app_password_change_me@localhost:5432/school_saas?schema=public"
# Separate high-privilege URL used ONLY by migrations (bypasses RLS to create schema/policies)
DATABASE_MIGRATE_URL="postgresql://school_saas_owner:owner_password_change_me@localhost:5432/school_saas?schema=public"

# Auth
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:3000
# Bare domain (no protocol) that schools' subdomains live under, e.g.
# "yourschoolsaas.com" in production. When set, any origin matching
# <slug>.<this value> is allowed in addition to CORS_ORIGIN above — needed
# for the subdomain-per-school login flow (<slug>.yourschoolsaas.com).
# Leave unset to disable wildcard-subdomain CORS entirely.
CORS_WILDCARD_DOMAIN=
# Bare domain (no protocol, no port) to share the refresh-token cookie
# across this API's host and every school's app host, e.g.
# "yourschoolsaas.com" in production ("localhost" for local dev with
# subdomains). Required for subdomain-per-school login sessions to persist
# — without it the frontend's middleware can never see the session cookie
# the API set on its own separate host. Leave unset for a single-origin
# deployment.
COOKIE_DOMAIN=

# PDF generation (report cards) — path to a Chrome/Chromium executable.
# On Windows, point this at your installed Chrome, e.g.:
#   CHROMIUM_EXECUTABLE_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
# If unset, defaults to a path that only exists in the original dev sandbox —
# you MUST set this yourself to use the report-card PDF export locally.
CHROMIUM_EXECUTABLE_PATH=

# --- Outbound notifications (all optional) ---
# Every one of these is independently optional. Leave a channel's vars
# unset and it keeps simulating (logs the message, no real send) — see
# src/modules/notifications/providers/registry.ts and
# GET /api/notifications/channel-status (shown on the dashboard's
# Notifications page as a warning banner for any channel that's still
# simulated). Set a channel's full var group to go live for that channel —
# no code changes or redeploy of anything but env config needed.

# SMS via Twilio (https://www.twilio.com/console) — needs all three.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number in E.164 format, e.g. "+15551234567".
TWILIO_SMS_FROM=

# WhatsApp via Meta's WhatsApp Business Cloud API
# (https://developers.facebook.com/docs/whatsapp/cloud-api/get-started) —
# needs both. WHATSAPP_CLOUD_PHONE_NUMBER_ID is the "Phone number ID" from
# the WhatsApp app in Meta's developer console, NOT the phone number itself.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# Email via plain SMTP — works with SendGrid/Mailgun/Amazon SES's SMTP
# relay, a school's own Google Workspace/Microsoft 365 account, or any
# other mail server. Needs all five.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (typically port 465), leave unset/"false" for
# STARTTLS (typically port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Envelope From header shown to recipients, e.g. "Your School <noreply@yourschool.com>".
SMTP_FROM=
